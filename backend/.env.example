# Environment variables for QueueMe Backend

# Application settings
PROJECT_NAME="QueueMe API"
API_V1_STR="/api/v1"

# Database URL
# Format for PostgreSQL with asyncpg: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql+asyncpg://queueme_user:strong_password_123@localhost:5432/queueme_db"

# JWT Settings
# Generate a strong secret key, e.g., using: openssl rand -hex 32
SECRET_KEY="your_super_secret_jwt_key_generated_with_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7 # If using refresh tokens

# Optional Email Settings (for notifications, password reset, etc.)
# MAIL_USERNAME=""
# MAIL_PASSWORD=""
# MAIL_FROM=""
# MAIL_SERVER=""
# MAIL_PORT=587
# MAIL_STARTTLS=True
# MAIL_SSL_TLS=False

# NOTE: Copy this file to .env and fill in your actual values.
# DO NOT commit the .env file with sensitive production credentials to version control.
# Ensure .env is listed in your .gitignore file.
